{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "ReverseProxy": {
      "Routes": {
        "productRoute": {
          "ClusterId": "productCluster",
          "Match": {
            "Path": "/api/products/{**catch-all}"
          }
        },
        "orderRoute": {
          "ClusterId": "orderCluster",
          "Match": {
            "Path": "/api/orders/{**catch-all}"
          }
        }
      },
      "Clusters": {
        "productCluster": {
          "Destinations": {
            "productDestination": {
              "Address": "https://serviceapi.orangeriver-1fcf0719.centralindia.azurecontainerapps.io/"
            }
          }
        },
        "orderCluster": {
          "Destinations": {
            "orderDestination": {
              "Address": "https://orderservices.orangeriver-1fcf0719.centralindia.azurecontainerapps.io/"
            }
          }
        }
      }
  },

  "AllowedHosts": "*"
}
